{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": [ "{{ kea_interfaz }}" ]
    },

    "lease-database": {
      "type": "memfile",
      "persist": true
    },

    "valid-lifetime": {{ kea_tiempo_concesion }},

    "subnet4": [
{% for red in kea_subredes %}
{% set terraform_reservas = kea_terraform_reservations | selectattr("network", "equalto", red.nombre) | list %}
{% set reservas_completas = (red.reservas | default([])) + terraform_reservas %}
      {
        "id": {{ red.id }},
        "subnet": "{{ red.subred }}",

        "pools": [
          {
            "pool": "{{ red.pool }}"
          }
        ],

        "option-data": [
          {
            "name": "routers",
            "data": "{{ red.gateway }}"
          },
          {
            "name": "domain-name-servers",
            "data": "{{ kea_dns | join(', ') }}"
          },
          {
            "name": "domain-name",
            "data": "{{ kea_dominio }}"
          }
        ],

        "reservations-out-of-pool": true,

        "reservations": [
{% for reserva in reservas_completas %}
          {
            "hostname": "{{ reserva.hostname }}",
            "hw-address": "{{ reserva.mac }}",
            "ip-address": "{{ reserva.ip }}"
          }{% if not loop.last %},{% endif %}
{% endfor %}
        ]
      }{% if not loop.last %},{% endif %}
{% endfor %}
    ]
  }
}
