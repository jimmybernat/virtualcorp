# GNU Make assignments, loaded by the root Makefile.
# Override only what differs in your local environment.

PROJECT_ROOT ?= $(CURDIR)
ARTIFACTS_DIR ?= $(PROJECT_ROOT)/artifacts
CONFIGS_DIR ?= $(PROJECT_ROOT)/configs
SSH_PUBLIC_KEY_DIR ?= $(CONFIGS_DIR)/ssh
SSH_PRIVATE_KEY_DIR ?= $(HOME)/.ssh

ROUTEROS_VERSION ?= 7.21.4
ROUTEROS_VDI_FILENAME ?= chr-$(ROUTEROS_VERSION).vdi
ROUTEROS_VDI_PATH ?= $(ARTIFACTS_DIR)/images/chr/$(ROUTEROS_VDI_FILENAME)
ROUTEROS_BOX_NAME ?= routeros-base
ROUTEROS_BOX_FILE ?= $(ARTIFACTS_DIR)/images/chr/$(ROUTEROS_BOX_NAME).box

# Debian 13 template installation
DEBIAN_VERSION ?= 13.7.0
DEBIAN_ISO_FILENAME ?= debian-$(DEBIAN_VERSION)-amd64-netinst.iso
DEBIAN_ISO_URL ?= https://cdimage.debian.org/debian-cd/$(DEBIAN_VERSION)/amd64/iso-cd/$(DEBIAN_ISO_FILENAME)
DEBIAN_ISO_PATH ?= $(ARTIFACTS_DIR)/images/debian/$(DEBIAN_ISO_FILENAME)
DEBIAN_ISO_SHA256 ?= a7ef94ac2fb9a7fec454552abd629b7cc9d5155c886165a45649f5ce6167e355

# Proxmox VE installation
PROXMOX_VERSION ?= 9.2-1
PROXMOX_ISO_FILENAME ?= proxmox-ve_$(PROXMOX_VERSION).iso
PROXMOX_ISO_URL ?= https://enterprise.proxmox.com/iso/$(PROXMOX_ISO_FILENAME)
PROXMOX_ISO_PATH ?= $(ARTIFACTS_DIR)/images/proxmox/$(PROXMOX_ISO_FILENAME)
PROXMOX_ISO_SHA256 ?= 4e88fe416df9b527624a175f24c9aa07c714d3332afb1ee3dbf3879573ef2c6c

VBOX_ROOT_GROUP ?= /VirtualCorp
VM_ROUTERS_GROUP ?= $(VBOX_ROOT_GROUP)/Routers
VM_TEMPLATES_GROUP ?= $(VBOX_ROOT_GROUP)/templates
# Set this only when VirtualBox is installed outside PATH or under another name.
# VBOXMANAGE_BIN ?= /path/to/VBoxManage
